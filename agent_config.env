# Agent Configuration - Edit this file to change run parameters
# The agent script will read these values

PYTHONIOENCODING=utf-8
POLICY_FILE=policy.max_fish.signa
TARGET_RESOURCE_PREFIXES=👑,💰

# Batch sizes
AGENT_BATCH=4096
CEM_TRAIN_BATCH=2048

# CEM Parameters - matching baseline recommendation
CEM_TRAIN_HORIZON=400
CEM_EVAL_EVERY=20
CEM_OBJECTIVE=max
CEM_POP=16
CEM_ITERS=8

# Improved CEM Features
CEM_GROUPED_SAMPLING=1
CEM_GROUP_CORR=0.7
CEM_TEMPORAL_BIAS=1
CEM_TEMPORAL_BLEND=0.3

# Simulation
AGENT_HORIZON=800
DECISION_ONLY=1
PHYSICS_BURST_MAX=128
FINAL_HEARTBEAT_EVERY=100

# GPU Planner (matching baseline_jan9 params)
PLANNER_ENABLE=1
PLANNER_AGGREGATED=1
PLANNER_EVERY=5
PLANNER_GAIN=0.8
