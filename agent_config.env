# Agent Configuration - Edit this file to change run parameters
# The agent script will read these values

PYTHONIOENCODING=utf-8
POLICY_FILE=policy.llm_balanced.signa
TARGET_RESOURCE_PREFIXES=👑,💰

# Batch sizes - full training run
AGENT_BATCH=4096
CEM_TRAIN_BATCH=2048

# CEM Parameters - DISABLED, using value network instead
CEM_TRAIN_HORIZON=200
CEM_EVAL_EVERY=20
CEM_OBJECTIVE=max
CEM_POP=8
CEM_ITERS=0

# Improved CEM Features - disabled (using value network)
CEM_GROUPED_SAMPLING=0
CEM_GROUP_CORR=0.7
CEM_TEMPORAL_BIAS=0
CEM_TEMPORAL_BLEND=0.3

# Simulation - extended horizon to push for more weeks
AGENT_HORIZON=1200
AGENT_USE_CRN=0
DECISION_ONLY=1
PHYSICS_BURST_MAX=128
FINAL_HEARTBEAT_EVERY=50

# GPU Planner - enabled to help guide value network
PLANNER_ENABLE=1
PLANNER_AGGREGATED=1
PLANNER_EVERY=10
PLANNER_GAIN=0.5

# Value Network (DreamerV4-inspired) - Training with crown-only objective
VALUE_NET_ENABLED=1
VALUE_NET_TRAIN=1
VALUE_NET_HIDDEN=256
VALUE_NET_LR=3e-4
VALUE_NET_GAMMA=0.997
VALUE_NET_LAMBDA=0.95
VALUE_ADV_WEIGHT=1.0
VALUE_GRADIENT_MODE=0
VALUE_TOPK=20
VALUE_NET_PATH=value_net.pt
VALUE_COMPUTE_EVERY=5
VALUE_TRAIN_EVERY=50
VALUE_TRAJ_LEN=25
VALUE_NET_DEBUG=0

# DreamerV4 Additions
VALUE_USE_SYMLOG=1
VALUE_USE_TWOHOT=1
VALUE_USE_PMPO=1
